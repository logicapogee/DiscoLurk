# Copy to docker/.env and adjust. compose passes the whole file to the container; empty values
# mean "use the application's default".

# Required: remote access token, at least 32 random bytes. Generate with: openssl rand -base64 48
# Alternatively set LURK_TOKEN_FILE to a file holding it (see the secrets block in docker-compose.yml).
LURK_TOKEN=

# Image tag, and the port lurk serve listens on (published on the host under the same number)
LURK_IMAGE_TAG=latest
LURK_PORT=8080

# Time zone for the daily window (IANA name); the container is UTC without it
TZ=Asia/Shanghai

# Site id: linuxdo or docofcard. The Profile used is <site>/default under ./data/disco-lurk/profiles/
LURK_SITE=linuxdo

# deep or quick
LURK_BROWSE_MODE=deep
# endless, topics:<n>, topics:<min>-<max>, time:<minutes>
LURK_RUN_MODE=topics:15-40

# Random daily schedule: runs per day (0 turns the schedule off), window, jitter minutes
LURK_RUNS_PER_DAY=2
LURK_WINDOW=07:00-23:00
LURK_JITTER_MIN=15
# Run once right after the first start (never again on restarts)
LURK_RUN_ON_START=true

# Automatic likes (off by default) and the chance per topic in percent
LURK_LIKE=false
LURK_LIKE_RATE=30

# Category slugs or paths, comma separated. Empty: linuxdo uses its default set; docofcard needs this.
LURK_CATEGORIES=

# Optional proxy, e.g. http://192.168.1.2:7890 or socks5://192.168.1.2:1080
LURK_PROXY=

# Unattended login, only for sites that sign in with a password form. Both built-in sites sign in
# in a visible browser instead: log in with the desktop app and copy the Profile into ./data.
LURK_USERNAME=
LURK_PASSWORD=
