{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiscoLurk",
  "version": "0.1.0",
  "identifier": "io.github.logicapogee.discolurk",
  "build": {
    "frontendDist": "../../../packages/ui/dist",
    "beforeDevCommand": {
      "script": "pnpm -w run build:desktop-deps",
      "wait": true
    },
    "beforeBuildCommand": "pnpm -w run build:desktop-deps"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DiscoLurk",
        "width": 1000,
        "height": 760,
        "minWidth": 900,
        "minHeight": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/lurk"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQUU1Qzc0RUQ1NzgxMEMKUldRTWdWZnRkRnl1UWtCaE9QN25oZ25HaGpicjVVV3pPTlNDVHRLa0cxWTBjVlMzM2xxZld0ZFIK",
      "endpoints": [
        "https://github.com/logicapogee/DiscoLurk/releases/latest/download/latest.json"
      ]
    }
  }
}
