{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiscoLurk",
  "version": "../../../package.json",
  "identifier": "io.github.logicapogee.discolurk",
  "build": {
    "frontendDist": "../../../packages/ui/dist",
    "beforeDevCommand": { "script": "pnpm -w run build:desktop-deps", "wait": true },
    "beforeBuildCommand": "pnpm -w run build:desktop-deps"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DiscoLurk",
        "width": 1000,
        "height": 760,
        "minWidth": 900,
        "minHeight": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/lurk"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
